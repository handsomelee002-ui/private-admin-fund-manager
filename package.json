{
  "name": "private-admin-fund-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node -e \"require('fs').rmSync('.next/dev/types', { recursive: true, force: true })\"",
    "build": "next build",
    "start": "next start",
    "test": "node --test src/**/*.test.js src/**/*.test.mjs",
    "test:feature": "node scripts/destructive-feature-tests.cjs",
    "test:e2e": "node scripts/browser-e2e-tests.cjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm test && npm run test:feature && npm run lint && npm run typecheck && npm run build && npm run test:e2e",
    "lint": "eslint"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@hookform/resolvers": "^5.2.2",
    "@vercel/postgres": "^0.10.0",
